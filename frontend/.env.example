# ============================================================
# TransportePeru - Frontend environment variables (CRA / craco)
# Copia este archivo a `.env` y completa con tus valores.
# Todas las variables expuestas al navegador DEBEN empezar con REACT_APP_.
# ============================================================

# URL base del backend (FastAPI). Sin slash final.
# Desarrollo local:
REACT_APP_BACKEND_URL=http://localhost:8001
# Producción (ejemplo): https://api.midominio.com
