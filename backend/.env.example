# ============================================================
# TransportePeru - Backend environment variables
# Copia este archivo a `.env` y completa con tus valores reales.
# NUNCA subas el archivo `.env` real al repositorio.
# ============================================================

# ---- Base de datos (MongoDB) - REQUERIDO ----
MONGO_URL=mongodb://localhost:27017
DB_NAME=transporteperu

# ---- Seguridad / Autenticación ----
# Clave para firmar los JWT. Cámbiala en producción por una cadena aleatoria larga.
JWT_SECRET=cambia-esta-clave-por-una-aleatoria-larga

# Token para el bootstrap inicial del primer superadmin.
# Se envía en el header `X-Install-Token` al endpoint de instalación.
INSTALL_TOKEN=genera-un-token-secreto-para-el-bootstrap

# Vida de los tokens. El access token corto reduce la ventana si es robado
# (el refresh token renueva la sesión automáticamente).
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Entorno: `development` o `production`. En production se exige JWT_SECRET y CORS_ORIGINS.
ENV=development

# ---- CORS ----
# Orígenes permitidos separados por comas. Usa `*` solo en desarrollo.
# Ej: https://app.midominio.com,https://admin.midominio.com
CORS_ORIGINS=*

# ---- Google Gemini (OCR de facturas/guías) ----
# Opcional: solo si usas el escaneo/OCR con Gemini (paquete google-genai).
GOOGLE_API_KEY=

# ---- AWS S3 (almacenamiento de archivos) ----
# Opcional: solo si guardas uploads en S3 en lugar del disco local.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# ---- Web Push (notificaciones VAPID) ----
# Opcional: solo si habilitas notificaciones push en el navegador.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
