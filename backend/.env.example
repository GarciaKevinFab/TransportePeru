# ============================================================
# TransportePeru - Backend environment variables
# Copia este archivo a `.env` y completa con tus valores reales.
# NUNCA subas el archivo `.env` real al repositorio.
# ============================================================

# ---- Base de datos (MongoDB) - REQUERIDO ----
MONGO_URL=mongodb://localhost:27017
DB_NAME=transporteperu

# ---- Seguridad / Autenticación ----
# Clave para firmar los JWT. Cámbiala en producción por una cadena aleatoria larga.
JWT_SECRET=cambia-esta-clave-por-una-aleatoria-larga

# Token para el bootstrap inicial del primer superadmin.
# Se envía en el header `X-Install-Token` al endpoint de instalación.
INSTALL_TOKEN=genera-un-token-secreto-para-el-bootstrap

# Vida de los tokens. El access token corto reduce la ventana si es robado
# (el refresh token renueva la sesión automáticamente).
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Entorno: `development` o `production`. En production se exige JWT_SECRET y CORS_ORIGINS.
ENV=development

# ---- Subdominio por empresa (APAGADO) ----
# VACÍO = una sola dirección para todo el mundo (fletepro.sisac.pe/login), que
# es como funciona hoy: cada usuario cae en su empresa por su cuenta, no por el
# dominio. Es lo más simple de explicar a un cliente y de operar: una dirección
# que recordar y ningún hostname que crear en Cloudflare por cada alta.
#
# Poniendo un dominio (p. ej. `sisac.pe`) se activa el modo <empresa>.sisac.pe:
# el backend resuelve la empresa por la cabecera Host antes de validar
# credenciales, acota el login a ella y pinta su marca en el acceso. Requiere
# además un hostname (o un comodín) en Cloudflare por cada empresa.
#
# En local, `localhost` hace que http://gye.localhost:8001 se comporte como
# gye.sisac.pe sin tocar el fichero hosts.
TENANT_BASE_DOMAIN=

# Subdominios que ninguna empresa puede usar, además de los que ya trae
# backend/tenant_host.py (fletepro, www, api, mail, dev...). Separados por comas.
TENANT_RESERVED_SLUGS=

# ---- CORS ----
# Orígenes permitidos separados por comas. Usa `*` solo en desarrollo.
# Ej: https://app.midominio.com,https://admin.midominio.com
#
# Los subdominios de inquilino NO van aquí: son tantos como clientes haya y
# habría que reiniciar el backend en cada alta. Se aceptan por expresión
# regular derivada de TENANT_BASE_DOMAIN (ver el bloque CORS de server.py).
CORS_ORIGINS=*

# ---- Google Gemini (OCR de facturas/guías) ----
# Opcional: solo si usas el escaneo/OCR con Gemini (paquete google-genai).
GOOGLE_API_KEY=

# ---- AWS S3 (almacenamiento de archivos) ----
# Opcional: solo si guardas uploads en S3 en lugar del disco local.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# ---- Web Push (notificaciones VAPID) ----
# Opcional: solo si habilitas notificaciones push en el navegador.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---- WhatsApp Business API (bot de captura de documentos) ----
# Opcional: solo si activas el bot de WhatsApp (Fase 3, backend/whatsapp_bot.py).
# Requiere un número de WhatsApp Business verificado en Meta y una URL HTTPS
# pública para el webhook (ver checklist de despliegue).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---- Postgres (migracion incremental desde MongoDB) ----
# El backend habla con las DOS bases mientras dura la transicion: MONGO_URL
# para las tablas que todavia no cortaron, y DATABASE_URL para las que si.
# Tablas ya en Postgres: proveedores, tipos_carga, liquidaciones_flete,
# liquidacion_lineas (ver db/migrations/001_corte_liquidacion_flete.sql).
#
# Se conecta con el rol app_backend, NUNCA con postgres: app_backend no puede
# evadir Row Level Security, asi que una consulta a la que se le olvide el
# filtro por empresa devuelve cero filas en vez de datos de otro tenant.
# En el VPS el host es `postgres` (nombre del servicio en docker-compose) y el
# contenedor no publica puerto al host.
DATABASE_URL=postgresql://app_backend:CONTRASENA@postgres:5432/transporteperu

# ---- Izipay (pasarela de pago, plataforma micuentaweb/Lyra) ----
# Sin estas variables el checkout SIGUE funcionando: registra el pedido y avisa
# de que el cobro con tarjeta todavia no esta activo. Con ellas, /comprar pinta
# el formulario de tarjeta de Izipay y el webhook activa el plan solo.
#
# Las da Izipay al activar el comercio (Back Office > Configuracion > Tienda >
# Claves de API REST). IZIPAY_PASSWORD es la clave de la API REST y ademas la
# que firma el webhook: es un secreto, y quien la tenga puede darse pagos por
# buenos.
IZIPAY_USERNAME=
IZIPAY_PASSWORD=
IZIPAY_PUBLIC_KEY=
IZIPAY_HMAC_KEY=
# Solo para pruebas contra otro entorno; por defecto https://api.micuentaweb.pe
IZIPAY_ENDPOINT=

# ---- Libro de Reclamaciones ----
# A donde llega el aviso interno de cada hoja nueva. Vacio = solo queda
# registrada y se consulta con GET /api/reclamaciones (superadmin); el plazo
# legal de respuesta es de 15 dias habiles, asi que conviene ponerlo.
RECLAMACIONES_EMAIL=
